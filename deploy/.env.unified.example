# Veynod unified deployment — copy to ./.env and fill the secrets.
# Nothing here is a default credential: compose refuses to start without them.

# --- database (one cluster, three databases) -----------------------------
POSTGRES_USER=veynod
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# --- product control plane ----------------------------------------------
API_PORT=8000
ENVIRONMENT=production
# >= 32 random characters; the API refuses to boot in production otherwise.
ADMIN_TOKEN=replace-with-at-least-32-random-characters
# Human console session keys and MCP settings as in AgentGraph/.env.example.
CORS_ORIGINS=[]
MCP_ALLOWED_HOSTS=[]
MCP_ALLOWED_ORIGINS=[]
BACKUP_HOST_DIR=./.veynod/backups

# --- kernel ---------------------------------------------------------------
KERNEL_ADMIN_KEY=replace-with-a-random-admin-key
# The Agent Runtime's own identity inside the Kernel (never the admin key).
KERNEL_SERVICE_KEY=replace-with-a-random-service-key
# A runner token bound to the workspace the Runtime executes in (vnk_...):
# create it once with POST /v1/admin/tokens on the kernel API.
KERNEL_RUNTIME_TOKEN=vnk_replace_with_a_runner_token
# Empty = the Kernel picks its default workspace; set it in multi-workspace
# deployments, or bind per project via POST /v1/projects/{p}/repositories.
KERNEL_WORKSPACE_ID=
# Multi-workspace assignment, keyed by product workspace UUID. Each value is
# a list of {kernel_workspace_id,kernel_base_url,credential_ref} objects.
# Production requires an entry for each product workspace UUID, including a
# single-workspace deployment. Example (replace both UUIDs):
# KERNEL_WORKSPACE_BINDINGS={"product-workspace-uuid":[{"kernel_workspace_id":"kernel-workspace-uuid","kernel_base_url":"http://kernel-api:8001","credential_ref":"KERNEL_RUNTIME_TOKEN"}]}
KERNEL_WORKSPACE_BINDINGS={}
# Additional Kernel endpoints and credential env names must be configured on
# both the product API and Runtime Worker.
KERNEL_ALLOWED_BASE_URLS=
KERNEL_ALLOWED_CREDENTIAL_REFS=
KERNEL_REPO_PATH=
VN_GATE_WORKERS=4
REPOS_DIR=/srv/veynod/repos
# Host UID:GID that owns REPOS_DIR (check with: stat -c '%u:%g' /srv/veynod/repos).
VN_GATE_DOCKER_USER=1000:1000
# Host docker group GID (check with: stat -c '%g' /var/run/docker.sock).
VN_GATE_DOCKER_GROUP_GID=988

# --- agent runtime --------------------------------------------------------
RUNTIME_API_KEY=replace-with-a-random-runtime-key
RUNTIME_WORKER_COUNT=4
RUNTIME_WORKER_LEASE_SECONDS=120
RUNTIME_SUBMISSION_DEADLINE_SECONDS=3600
RUNTIME_CONTEXT_TOKEN_BUDGET=8000
# Empty string = every Kernel capability.
RUNTIME_KERNEL_TOOLS=

# --- model provider (OpenAI-compatible) ----------------------------------
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=replace-with-the-provider-key
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_SECONDS=60

# --- operational flags ----------------------------------------------------
LOG_LEVEL=INFO
# Internal operator consoles (/dashboard/internal/*). Off by default: they are
# not product navigation (ADR-018).
INTERNAL_VIEWS_ENABLED=false
# The event inbox is the only projection path; the sweeps stay off.
AGENT_RUNTIME_PROJECTION_ENABLED=false
CODE_PROJECTION_ENABLED=false
