# Agent Runtime image (API + worker share it).
#
# Build from the repository root:
#   docker build -f deploy/Dockerfile.runtime -t veynod-runtime .

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates && rm -rf /var/lib/apt/lists/*

COPY agent_runtime/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY agent_runtime ./agent_runtime
COPY contracts ./contracts

EXPOSE 8002
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8002/healthz', timeout=4)"

CMD ["uvicorn", "agent_runtime.api:app", "--host", "0.0.0.0", "--port", "8002"]
