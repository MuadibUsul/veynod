{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veynod.com/contracts/event-envelope.schema.json",
  "title": "Veynod cross-domain event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "event_version", "tenant_id", "workspace_id", "aggregate_type", "aggregate_id", "aggregate_version", "producer", "occurred_at", "correlation_id", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "event_version": {"type": "integer", "minimum": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "format": "uuid"},
    "project_id": {"type": ["string", "null"]},
    "diagram_id": {"type": ["integer", "null"], "minimum": 1},
    "diagram_version": {"type": ["integer", "null"], "minimum": 1},
    "chunk_key": {"type": ["string", "null"]},
    "product_task_key": {"type": ["string", "null"]},
    "runtime_run_id": {"type": ["string", "null"]},
    "attempt_id": {"type": ["string", "null"]},
    "kernel_task_id": {"type": ["string", "null"]},
    "lease_id": {"type": ["string", "null"]},
    "submission_id": {"type": ["string", "null"]},
    "placement_id": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": ["string", "null"], "minLength": 1},
    "aggregate_type": {"type": "string", "minLength": 1},
    "aggregate_id": {"type": "string", "minLength": 1},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "producer": {"enum": ["agentgraph", "agent-runtime", "veynod-kernel"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "payload_ref": {"type": ["string", "null"]},
    "payload": {"type": "object"}
  }
}
