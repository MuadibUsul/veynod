{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veynod",
  "version": "0.1.0",
  "identifier": "com.veynod.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veynod",
        "url": "https://veynod.com/dashboard/",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
