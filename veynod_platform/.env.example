# AgentGraph / Veynod 3.x control plane
AGENTGRAPH_URL=http://127.0.0.1:8000
# Either set a workspace key pair, or let the gateway create one with the admin token.
# AGENTGRAPH_WORKSPACE_ID=
# AGENTGRAPH_WORKSPACE_KEY=
AGENTGRAPH_ADMIN_TOKEN=

# Veynod Kernel 4.x code plane
KERNEL_URL=http://127.0.0.1:8001
KERNEL_ADMIN_KEY=dev-admin
# Required when the Kernel instance has a fixed code workspace.
KERNEL_WORKSPACE_ID=

# Gateway state
PLATFORM_DB_PATH=.run/platform.db
PLATFORM_SYNC_INTERVAL_SECONDS=2
PLATFORM_REQUEST_TIMEOUT=30
