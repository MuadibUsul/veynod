# --- Veynod Kernel v4.0 ---
# PostgreSQL 16 connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://veynod:veynod@127.0.0.1:5432/veynod
# Per-process SQLAlchemy pool. Size the sum across API/gate-worker processes
# below PostgreSQL max_connections (leave headroom for migrations/admin).
VN_DB_POOL_SIZE=20
VN_DB_MAX_OVERFLOW=40

# dev | prod. In dev, an unknown vnk_ token is accepted and hashed to a hub id.
# In prod, only tokens issued through the admin API / bootstrap are accepted.
VN_AUTH_MODE=dev

# Single-workspace deployments may pin the workspace used by the 6 syscalls.
# Leave empty to use the oldest workspace.
# VN_DEFAULT_WORKSPACE_ID=

# Phase 4: bind this API/worker/gate process to one execution cell. Empty means
# all cells. A cell owns the repositories placed in it; moving a repository
# increments its placement epoch and fences the old cell's merge.
# VN_CELL_ID=

# Admin API protection (X-Admin-Key). Required to create workspaces/tokens/tasks.
VN_ADMIN_API_KEY=change-me

# Optional: register this raw runner token at startup (development convenience).
# VN_BOOTSTRAP_RUNNER_TOKEN=vnk_dev_runner_token

# Deterministic gate commands. pyright and pytest must exist on the server PATH.
VN_TYPECHECK_CMD=pyright
VN_TEST_CMD=pytest -q --tb=short
VN_LINT_CMD=ruff check
# Set to true only for local smoke tests; production gates must lint.
VN_SKIP_LINT=false
VN_COLLECT_CMD=pytest --collect-only -q
# Set to true only for local smoke tests; production gates must typecheck.
VN_SKIP_TYPECHECK=false

# Gate timeout per subprocess (seconds) and output retention.
VN_GATE_TIMEOUT_SECONDS=600
VN_GATE_OUTPUT_CHARS=4000

# Lease and merge behaviour
VN_LEASE_SECONDS=600
VN_VERIFY_LEASE_SECONDS=1800
VN_MAX_MERGE_ATTEMPTS=4
# Pre-created detached worktrees reused by the gate (avoids per-task worktree add/remove).
VN_GATE_WORKTREE_POOL_SIZE=8
# Opt-in: merge verified patches with git merge-tree when the file skeleton is stable
# and every read/test/target symbol's source is untouched (same-file symbols allowed).
# Default false keeps the deterministic gate (Stage 3/4 re-run on the new HEAD).
VN_FAST_FORWARD_MERGE=false
# Single-kernel fast claim: skip the per-workspace advisory lock and rely on the
# Rust Mutex decision + conditional UPDATE + NOT EXISTS fence. Set false for
# multi-process kernels sharing one database.
VN_SINGLE_KERNEL_CLAIM=true
# Rebuild symbol_edges in a background queue after commit (outside the merge lock).
# Set false if a caller needs the table immediately after submit returns.
VN_ASYNC_EDGE_REBUILD=true
VN_REAPER_INTERVAL_SECONDS=30
VN_REAP_VERIFYING_AFTER_SECONDS=3600

# Allow a non-bare repository whose main branch is checked out. Dangerous:
# update-ref would move HEAD while the working tree stays behind.
VN_ALLOW_NONBARE_REPO=false

# Apply the genesis schema on startup.
VN_AUTO_INIT_DB=true

# Durable asynchronous patch submissions (v2 protocol).
# QUEUED rows survive restart; workers resume them on startup. 0 disables
# processing but still accepts/persists submissions.
VN_SUBMISSION_WORKERS=8
VN_SUBMISSION_POLL_SECONDS=0.25
# reject: /v1/syscalls/submit_patch returns 410 and points at /v2.
# sync: temporary escape hatch for old clients during migration.
VN_LEGACY_SUBMIT_MODE=reject

# Independent gate worker (API no longer runs pytest/Git).
VN_WORK_LEASE_SECONDS=300
VN_WORK_HEARTBEAT_SECONDS=30
VN_WORK_MAX_ATTEMPTS=5
VN_WORKER_POLL_SECONDS=1.0
# local = dev/CI only; docker + image = production isolation.
VN_GATE_SANDBOX=local
# VN_GATE_SANDBOX_IMAGE=veynod-gate:latest
VN_GATE_CPU_LIMIT=1.0
VN_GATE_MEMORY_MB=512
VN_GATE_PIDS_LIMIT=128
# Docker mode only: run as a non-root uid:gid, no network, bounded file handles.
# Production refuses docker mode without VN_GATE_DOCKER_USER and network=none.
# VN_GATE_DOCKER_USER=65534:65534
VN_GATE_DOCKER_NETWORK=none
VN_GATE_NOFILE_LIMIT=256

# Per-repository merge coordinator workspace lease.
VN_MERGE_COORDINATOR_LEASE_SECONDS=60

# Per-repository admission control: stop issuing tasks when the gate or merge
# queue is near capacity, so VERIFYING cannot grow unbounded.
VN_ADMISSION_GATE_QUEUE_LIMIT=256
VN_ADMISSION_MERGE_QUEUE_LIMIT=128
# reject -> 429 + Retry-After; defer -> 200 leased=false + retry_after_seconds.
VN_ADMISSION_MODE=reject
VN_ADMISSION_RETRY_AFTER_SECONDS=5
# Concurrent reservation slots; if all are busy the pull gets 429 immediately
# instead of holding a DB connection behind a lock.
VN_ADMISSION_CLAIM_SLOTS=32

# Single authoritative Rust scheduler core per repository. Only the authority
# lease holder uses the in-process core; other API instances fall back to the
# SQL/advisory-lock claim path. The durable fence is still the conditional UPDATE.
VN_SCHEDULER_AUTHORITY_LEASE_SECONDS=30

# Persistent edge-rebuild jobs (recoverable after a process crash).
VN_EDGE_REBUILD_LEASE_SECONDS=120
VN_EDGE_REBUILD_MAX_ATTEMPTS=5

# Transactional outbox poll interval for SSE notifications (seconds).
VN_OUTBOX_POLL_SECONDS=0.1
